# Postgres
DATABASE_URL=postgres://dcentral:CHANGEME@localhost:5432/dcentral_fieldops

# Veramo / node identity
# The domain this node's did:webvh resolves under. Real value is an open
# decision (see docs/ARCHITECTURE.md "Open decisions") -- sodboysltd.org
# vs. a separate D-Central-branded domain. Placeholder for local dev.
NODE_DID_DOMAIN=id.dcentral-fieldops.local
VERAMO_KMS_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32

# MCP server
MCP_HTTP_PORT=8090
