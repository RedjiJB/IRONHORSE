# Postgres
DATABASE_URL=postgres://dcentral:CHANGEME@localhost:5432/dcentral_fieldops

# Node identity
# The domain this node's did:web resolves under -- decided: a subdomain of
# sodboysltd.org (v1's client-facing domain), not a separate D-Central-
# branded domain. See docs/ARCHITECTURE.md "Open decisions". The DNS
# record + Cloudflare Tunnel route for id.sodboysltd.org don't exist yet --
# this only sets the DID's own namespace; real HTTPS resolution still
# needs that infra provisioned separately.
NODE_DID_DOMAIN=id.sodboysltd.org

# MCP server
MCP_HTTP_PORT=8090

# REST facade (Task #156 -- bridges the vendored dashboard frontend to
# this backend's domain logic; a separate process from the MCP transport).
# Note: on Windows, Hyper-V's dynamic port-exclusion range can silently
# block arbitrary ports (EACCES, not EADDRINUSE) -- 8199 is confirmed free
# in dev; if it ever fails, check `netsh interface ipv4 show
# excludedportrange protocol=tcp` and pick a port outside every range.
FACADE_HTTP_PORT=8199

# Documents: local filesystem storage for uploaded files (permits,
# contracts, receipts, WhatsApp photos). Defaults to ./uploads if unset.
UPLOAD_DIR=./uploads

# Exceptions worker: how often (ms) the field-ops alert checks run.
# Defaults to 5 minutes, same as v1.
ALERTS_CHECK_INTERVAL_MS=300000

# Chat assistant (read-only, src/domain/chat.ts): DeepSeek primary,
# Anthropic fallback -- both already external_accepted in
# policy/sovereignty_tiers.yaml, the same chain v1 runs (v1's fuller
# policy-named chain also includes Kimi/OpenAI/Gemini; those slot in as
# one more PROVIDER_CHAIN entry each in chat.ts once a key exists for
# them). Leave either blank to skip that provider -- the façade route
# returns a clear 503 rather than a raw error until at least one is set.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
